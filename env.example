# Copy to .env and fill in the iDRAC details:  cp env.example .env && chmod 600 .env

# iDRAC6 address and an Administrator-level iDRAC login.
# Single-quote the password so characters like $ ! @ pass through literally.
IDRAC_HOST=
IDRAC_USER=root
IDRAC_PASSWORD=''
TZ=America/New_York

# true = log what it would do without touching the fans. Use it for a first run.
MONITOR_ONLY=true

# Quiet profile, measured on an R710 (iDRAC6 firmware 2.91):
#   2% = 1200 RPM, 4% = 1560, 6% = 1800, 10% = 2160, 15% = 2760, 20% = 3360,
#   30% = 4440. Dell automatic sits around 3600 RPM at idle.
# Fan curve on the front inlet (Ambient Temp) sensor: "tempC:percent" points.
FAN_CURVE="24:4 26:6 28:10 30:15 32:25 34:40"
MIN_FAN=4
MAX_FAN=100

# The R710 reports no CPU temperatures, so system power draw stands in for CPU load.
# Check your idle draw with "fanctl status" (System Level) and tune these around it.
# POWER_CURVE raises the fans as draw climbs; the higher of the two curves wins.
POWER_CURVE="160:4 175:8 190:15"
# At or above POWER_AUTO_W the fans go back to Dell automatic, which can see the
# CPU temperatures internally. 0 turns this check off.
POWER_AUTO_W=200
POWER_HYSTERESIS_W=20

# Other failsafes: any of these hands fan control back to Dell automatic.
AMBIENT_AUTO_C=35
CPU_MARGIN_AUTO_C=20
FAN_FAIL_RPM=1000
HYSTERESIS_C=3

CHECK_INTERVAL=30
IPMI_CIPHER=3

# Web page at http://<docker host>:WEB_PORT
WEB_PORT=8710
# Optional login for the web page. With WEB_PASSWORD empty, anyone on your
# network can open it. Single-quote the password.
WEB_USER=admin
WEB_PASSWORD=''
# Days of readings kept for the history charts.
HISTORY_DAYS=7
